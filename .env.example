# Static Ads Engine — Secrets
# Kopiere diese Datei nach .env und fülle nur, was du nutzt. .env ist per .gitignore ausgeschlossen.
# Higgsfield, Trendtrack, Figma und ClickUp laufen über Connectoren in Claude Code, nicht über .env.

# --- Meta Marketing API, nur lesend (Agent LEARNINGS, optional) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_API_VERSION=v21.0

# --- Unsplash (optional, nur wenn du Stock-Motive als Referenz einsetzt) ---
UNSPLASH_ACCESS_KEY=
